pipeline {

    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                sh 'npx playwright install'
            }
        }

        stage('Clean Previous Results') {
            steps {
                sh 'rm -rf allure-results'
                sh 'rm -rf test-results'
            }
        }

        stage('Run Web Tests') {
            steps {
                script {
                    def exitCode = sh(
                        script: 'npx playwright test'
                        returnStatus: true
                    )
                    if (exitCode != 0) {
                        currentBuild.result = 'FAILURE'
                    } else {
                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                junit(
                    allowEmptyResults: true,
                    testResults: 'test-results/results.xml',
                    skipPublishingChecks: true
                )
            }
        }

        stage('Generate Allure Report') {
            steps {
                allure includeProperties: false,
                       jdk: '',
                       results: [[path: 'allure-results']]
            }
        }

    }

    post {
        always {
            script {
                if (currentBuild.result == 'UNSTABLE') {
                    currentBuild.result = 'SUCCESS'
                }

                def isSuccess  = (currentBuild.result == 'SUCCESS')
                def statusIcon = isSuccess ? '✅' : '❌'
                def statusText = isSuccess ? 'SUCCESS' : 'FAILED'

                emailext(
                    to: '$DEFAULT_RECIPIENTS',
                    from: 'aswinnarayanadas@gmail.com',
                    subject: "${statusIcon} BUILD ${statusText} - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    mimeType: 'text/html',
                    body: """
                        <p><b>Build Status:</b> ${statusText} ${statusIcon}</p>
                        <p><b>Job:</b> ${env.JOB_NAME} #${env.BUILD_NUMBER}</p>
                        <p><b>Duration:</b> ${currentBuild.durationString}</p>
                        <p><b>Test File:</b> newtab.spec.ts</p>
                        <p><b>Passed:</b> ${isSuccess ? '1' : '0'}</p>
                        <p><b>Failed:</b> ${isSuccess ? '0' : '1'}</p>
                        <p><b>Allure Report:</b> <a href="${env.BUILD_URL}allure">Click here</a></p>
                    """
                )
            }
        }
    }
}