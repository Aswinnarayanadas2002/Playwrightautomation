pipeline {

    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                sh 'npx playwright install'
            }
        }

        stage('Run Web Tests') {
            steps {
                sh 'npx playwright test tests/newtab.spec.ts'
            }
        }

        stage('Publish Test Results') {
            steps {
                junit(
                    allowEmptyResults: true,
                    testResults: 'test-results/results.xml',
                    skipPublishingChecks: true
                )
            }
        }

        stage('Generate Allure Report') {
            steps {
                allure includeProperties: false, jdk: '', results: [[path: 'allure-results']]
            }
        }

    }

    post {
        always {
            script {
                if (currentBuild.result == 'UNSTABLE') {
                    currentBuild.result = 'SUCCESS'
                }
            }
        }

        success {
            emailext(
                to: 'aswinaryanadas@gmail.com',
                from: 'aswinaryanadas@gmail.com',
                subject: "✅ BUILD SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <html>
                    <body>
                        <h2 style="color:green;">✅ Build Successful!</h2>
                        <table>
                            <tr><td><b>Job:</b></td><td>${env.JOB_NAME}</td></tr>
                            <tr><td><b>Build Number:</b></td><td>#${env.BUILD_NUMBER}</td></tr>
                            <tr><td><b>Status:</b></td><td>SUCCESS ✅</td></tr>
                            <tr><td><b>Duration:</b></td><td>${currentBuild.durationString}</td></tr>
                            <tr><td><b>Build URL:</b></td><td><a href="${env.BUILD_URL}">${env.BUILD_URL}</a></td></tr>
                        </table>
                        <br>
                        <p>All Playwright tests passed successfully! 🎉</p>
                    </body>
                    </html>
                """,
                mimeType: 'text/html'
            )
        }

        failure {
            emailext(
                to: 'aswinaryanadas@gmail.com',
                
                subject: "❌ BUILD FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <html>
                    <body>
                        <h2 style="color:red;">❌ Build Failed!</h2>
                        <table>
                            <tr><td><b>Job:</b></td><td>${env.JOB_NAME}</td></tr>
                            <tr><td><b>Build Number:</b></td><td>#${env.BUILD_NUMBER}</td></tr>
                            <tr><td><b>Status:</b></td><td>FAILED ❌</td></tr>
                            <tr><td><b>Duration:</b></td><td>${currentBuild.durationString}</td></tr>
                            <tr><td><b>Build URL:</b></td><td><a href="${env.BUILD_URL}">${env.BUILD_URL}</a></td></tr>
                        </table>
                        <br>
                        <p>Please check the build logs for details.</p>
                    </body>
                    </html>
                """,
                mimeType: 'text/html'
            )
        }

    }

}