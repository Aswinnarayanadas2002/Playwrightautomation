pipeline {
    agent any

    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                sh 'npx playwright install'
            }
        }

        stage('Run Web Tests') {
            steps {
                // Using 'returnStatus: true' allows the pipeline to continue 
                // without a try-catch, capturing the exit code instead.
                script {
                    def exitCode = sh(script: 'npx playwright test tests/newtab.spec.ts', returnStatus: true)
                    if (exitCode != 0) {
                        echo "Tests failed with exit code ${exitCode}. Marking as Unstable for reporting."
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }

        stage('Publish Results') {
            steps {
                // Publish JUnit results
                junit(
                    allowEmptyResults: true,
                    testResults: '**/results.xml', // Broadened path to find the file easier
                    skipPublishingChecks: true
                )
                // Generate Allure
                allure includeProperties: false, jdk: '', results: [[path: 'allure-results']]
            }
        }
    }

    post {
        always {
            script {
                // Determine styling based on the actual result
                // If you want "UNSTABLE" to look like "SUCCESS" in the email:
                def isSuccessful = (currentBuild.result == 'SUCCESS' || currentBuild.result == 'UNSTABLE')
                
                def subjectStatus = isSuccessful ? "✅ TEST COMPLETE" : "❌ BUILD FAILED"
                def statusColor = isSuccessful ? "#28a745" : "#dc3545"
                def statusIcon = isSuccessful ? "✅" : "❌"

                emailext(
                    to: 'aswinnarayanadas@gmail.com',
                    subject: "${subjectStatus} - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    mimeType: 'text/html',
                    body: """
                        <html>
                        <body style="font-family: Arial, sans-serif;">
                            <h2 style="color:${statusColor};">${statusIcon} Build ${currentBuild.result}!</h2>
                            <hr>
                            <p><b>Job:</b> ${env.JOB_NAME}</p>
                            <p><b>Status:</b> <span style="color:${statusColor};">${currentBuild.result}</span></p>
                            <p><b>Allure Report:</b> <a href="${env.BUILD_URL}allure">View Detailed Test Results</a></p>
                            <p><b>Console Log:</b> <a href="${env.BUILD_URL}console">View Jenkins Log</a></p>
                        </body>
                        </html>
                    """
                )
            }
        }
    }
}